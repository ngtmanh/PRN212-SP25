<UserControl x:Class="Prn212.ManageMember"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prn212"
        mc:Ignorable="d"
             Height="300"
             Width="Auto"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Search Bar -->
        <StackPanel Orientation="Horizontal"
                    Margin="10">
            <Label Content="Tìm kiếm:"
                   VerticalAlignment="Center" />
            <TextBox x:Name="SearchBox"
                     Width="200"
                     Margin="5,0" />
            <Button Content="Tìm"
                    Width="75"
                    Background="#2196F3" 
                    Foreground="White"
                    Click="SearchButton_Click" />
            <Button  Margin="100 0 0 0" Content="Export" Width="70" HorizontalAlignment="Right"
                     Click="Button_Click" />
        </StackPanel>

        <!-- DataGrid for Residents -->
        <DataGrid x:Name="ResidentsDataGrid"
                    AutoGenerateColumns="False"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    CanUserAddRows="false"
                  Grid.Row="1"
                  Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding MemberId}"
                                    Width="50" />
                <DataGridTextColumn Header="Họ và tên"
                                    Binding="{Binding User.FullName}"
                                    Width="*" />
                <DataGridTextColumn Header="Địa chỉ"
                                    Binding="{Binding User.Address}"
                                    Width="*" />
                <DataGridTextColumn Header="Chủ hộ"
                                    Binding="{Binding User.FullName}"
                                    Width="*" />
                <DataGridTextColumn Header="Thành viên"
                                    Binding="{Binding Relationship}"
                                    Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- CRUD Buttons -->
        <StackPanel Orientation="Horizontal"
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    Margin="10">
            <Button Content="Thêm thành viên"
                    Width="100"
                    Height="40"
                    Margin="10"  
                    Background="#2196F3" 
                    Foreground="White"
                    FontSize="13"
                    Click="AddButton_Click" />
            <Button Content="Xem chi tiết"
                    Width="100"
                    Margin="10" 
                    Foreground="White"
                    Background="#2ECC71"
                    FontSize="13"
                    Click="ButtonView_Click" />
            <Button Content="Xóa"
                    Width="100"
                    Margin="10"
                    Foreground="White"
                    Background="#E74C3C"
                    FontSize="13"
                    Click="DeleteButton_Click" />
        </StackPanel>
    </Grid>
</UserControl>
