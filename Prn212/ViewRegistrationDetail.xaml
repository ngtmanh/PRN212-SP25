<Window x:Class="Prn212.ViewRegistrationDetail"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prn212"
        mc:Ignorable="d"
        Title="Thông tin chi tiết của đơn" Height="500" Width="600">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Loại đơn duyệt:" FontWeight="Bold" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtRegistrationType" IsReadOnly="True" Margin="5" Padding="5"/>

        <Label Grid.Row="1" Grid.Column="0" Content="Trạng thái đơn:" FontWeight="Bold" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtStatus" IsReadOnly="True" Margin="5" Padding="5"/>

        <Label Grid.Row="2" Grid.Column="0" Content="Số CCCD/CMND người gửi:" FontWeight="Bold" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtIdentity" IsReadOnly="True" Margin="5" Padding="5"/>

        <Label Grid.Row="3" Grid.Column="0" Content="Giấy tờ hộ khẩu:" FontWeight="Bold" VerticalAlignment="Center"/>        
        <Button Content="Download File" Grid.Row="3" Grid.Column="1" Width="150" Height="40" Click="BtnDownload_Click" Margin="5" Padding="5" HorizontalAlignment="Left"/>

        <Label Grid.Row="4" Grid.Column="0" Content="Thông tin mô tả:" FontWeight="Bold" VerticalAlignment="Top"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtDescription" IsReadOnly="True" Margin="5" Padding="5" TextWrapping="Wrap" AcceptsReturn="True" Height="100"/>

        <Label Grid.Row="5" Grid.Column="0" Content="Chú thích, nhận xét:" FontWeight="Bold" VerticalAlignment="Top"/>
        <TextBox Grid.Row="5" Grid.Column="1" x:Name="txtComments" IsReadOnly="True" Margin="5" Padding="5" TextWrapping="Wrap" AcceptsReturn="True" Height="100"/>

        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnApprove" Content="Duyệt" Width="100" Margin="5" Click="BtnApprove_Click"/>
            <Button x:Name="btnReject" Content="Từ chối" Width="100" Margin="5" Click="BtnReject_Click"/>
            <Button x:Name="btnClose" Content="Đóng" Width="100" Margin="5" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>

</Window>