<Window x:Class="Prn212.ViewRegistrationDetail"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prn212"
        mc:Ignorable="d"
        Title="ViewRegistrationDetail" Height="450" Width="800">
    <Grid>
        <StackPanel Margin="10">
            <TextBlock Text="Chi tiết đăng ký" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" />

            <TextBlock Text="Xác minh danh tính:" FontWeight="Bold"/>
            <TextBox x:Name="txtVerifyingIdentity" IsReadOnly="True" Margin="0,5"/>

            <TextBlock Text="Xác minh nơi cư trú:" FontWeight="Bold"/>
            <TextBox x:Name="txtVerifyingResidence" IsReadOnly="True" Margin="0,5"/>

            <TextBlock Text="Địa chỉ hộ khẩu:" FontWeight="Bold"/>
            <TextBox x:Name="txtHouseholdAddress" IsReadOnly="True" Margin="0,5"/>

            <TextBlock Text="Thành viên hộ khẩu:" FontWeight="Bold"/>
            <ListBox x:Name="lstHouseholdMembers" Height="100" Margin="0,5"/>

            <Button Content="Quay lại" Width="100" HorizontalAlignment="Right" Click="BtnBack_Click"/>
        </StackPanel>
    </Grid>
</Window>
