<Window x:Class="Prn212.Register"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prn212"
        mc:Ignorable="d"
        Title="Đăng kí" Height="auto" Width="400">
    <Grid Margin="20">
        <StackPanel>
            <Label Content="Họ và tên" FontSize="14" FontWeight="Bold"/>
            <TextBox x:Name="txtFullName" Width="300" Height="40" FontSize="14" Padding="10"/>

            <Label Content="Email" FontSize="14" FontWeight="Bold"/>
            <TextBox x:Name="txtEmail" Width="300" Height="40" FontSize="14" Padding="10"/>

            <Label Content="Mật khẩu" FontSize="14" FontWeight="Bold"/>
            <PasswordBox x:Name="txtPassword" Width="300" Height="40" FontSize="14" Padding="10"/>

            <Label Content="Nhập lại Mật khẩu" FontSize="14" FontWeight="Bold"/>
            <PasswordBox x:Name="txtRePassword" Width="300" Height="40" FontSize="14" Padding="10"/>

            <Label Content="Địa chỉ" FontSize="14" FontWeight="Bold"/>
            <TextBox x:Name="txtAddress" Width="300" Height="40" FontSize="14" Padding="10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                <Button Content="Đăng ký" Width="140" Height="45" FontSize="14" Margin="10" Click="BtnRegister_Click"/>
                <Button Content="Hủy" Width="140" Height="45" FontSize="14" Margin="10" Click="BtnCancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
