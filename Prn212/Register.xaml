<Window x:Class="Prn212.Register"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prn212"
        mc:Ignorable="d"
        Title="Register" Height="450" Width="350" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- Full Name -->
            <Label Content="Full Name" FontSize="14" FontWeight="Bold"/>
            <Border CornerRadius="8" BorderBrush="Gray" BorderThickness="1" Padding="3">
                <TextBox x:Name="txtFullName" Width="250" Height="30" FontSize="14" Background="White"/>
            </Border>

            <!-- Email -->
            <Label Content="Email" FontSize="14" FontWeight="Bold"/>
            <Border CornerRadius="8" BorderBrush="Gray" BorderThickness="1" Padding="3">
                <TextBox x:Name="txtEmail" Width="250" Height="30" FontSize="14" Background="White"/>
            </Border>

            <!-- Password -->
            <Label Content="Password" FontSize="14" FontWeight="Bold"/>
            <Border CornerRadius="8" BorderBrush="Gray" BorderThickness="1" Padding="3">
                <PasswordBox x:Name="txtPassword" Width="250" Height="30" FontSize="14" Background="White"/>
            </Border>

            <Label Content="Password" FontSize="14" FontWeight="Bold"/>
            <Border CornerRadius="8" BorderBrush="Gray" BorderThickness="1" Padding="3">
                <PasswordBox x:Name="txtRePassword" Width="250" Height="30" FontSize="14" Background="White"/>
            </Border>

            <!-- Address -->
            <Label Content="Address" FontSize="14" FontWeight="Bold"/>
            <Border CornerRadius="8" BorderBrush="Gray" BorderThickness="1" Padding="3">
                <TextBox x:Name="txtAddress" Width="250" Height="30" FontSize="14" Background="White"/>
            </Border>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                <!-- Register Button -->
                <Button Content="✔ Đăng ký" Width="120" Height="35"
                    Foreground="White" Background="#2ECC71" BorderThickness="0"
                    FontSize="14" Cursor="Hand" Click="BtnRegister_Click"
                    Margin="5">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Cancel Button -->
                <Button Content="✖ Hủy" Width="100" Height="35"
                    Foreground="White" Background="#E74C3C" BorderThickness="0"
                    FontSize="14" Cursor="Hand" Click="BtnCancel_Click"
                    Margin="5">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
