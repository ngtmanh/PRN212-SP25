<Window x:Class="Prn212.AddRegistration"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prn212"
        mc:Ignorable="d"
        Title="AddRegistration" Height="450" Width="800">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Registration Type:" />
            <ComboBox x:Name="cmbRegistrationType">
                <ComboBoxItem Content="Permanent" />
                <ComboBoxItem Content="Temporary" />
                <ComboBoxItem Content="TemporaryStay" />
            </ComboBox>

            <TextBlock Text="Description:" />
            <TextBox x:Name="txtDescription" />

            <TextBlock Text="Verifying Identity:" />
            <TextBox x:Name="txtVerifyingIdentity" />

            <TextBlock Text="Verifying Residence:" />
            <TextBox x:Name="txtVerifyingResidence" />

            <Button Content="Submit" Click="BtnSubmit_Click" />
        </StackPanel>
    </Grid>
</Window>
