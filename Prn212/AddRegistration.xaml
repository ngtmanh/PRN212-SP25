<Window x:Class="Prn212.AddRegistration"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prn212"
        mc:Ignorable="d"
        Title="AddRegistration" Height="450" Width="800">
    <Grid>
        <TextBlock Text="Chọn loại đăng ký:" Margin="10,10,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="cmbRegistrationType" Width="200" Height="25" Margin="10,40,0,0" VerticalAlignment="Top"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,100,0,0">
            <Button x:Name="btnSubmit" Content="Thêm Đơn" Width="100" Height="30" Click="BtnSubmit_Click" Margin="10"/>
            <Button x:Name="btnCancel" Content="Hủy" Width="100" Height="30" Click="BtnCancel_Click" Margin="10"/>
        </StackPanel>
    </Grid>
</Window>
