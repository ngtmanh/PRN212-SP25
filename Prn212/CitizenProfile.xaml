<Window x:Class="Prn212.CitizenProfile"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prn212"
        mc:Ignorable="d"
        Title="Dữ liệu cá nhân" Height="500" Width="400" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel Width="300" HorizontalAlignment="Center" VerticalAlignment="Center">

            <Label Content="Họ và tên" FontSize="14" FontWeight="Bold"/>
            <TextBox x:Name="txtFullName" Width="280" Height="30" 
                 Padding="5" FontSize="14" BorderBrush="Gray" BorderThickness="1" 
                 Background="White"/>

            <Label Content="Email" FontSize="14" FontWeight="Bold"/>
            <TextBox x:Name="txtEmail" Width="280" Height="30"
                 Padding="5" FontSize="14" BorderBrush="Gray" BorderThickness="1"
                 Background="White"/>

            <Label Content="Mật khẩu cũ" FontSize="14" FontWeight="Bold"/>
            <PasswordBox x:Name="txtOldPassword" Width="280" Height="30"
                     Padding="5" FontSize="14" BorderBrush="Gray" BorderThickness="1"
                     Background="White"/>

            <Label Content="Mật khẩu mới" FontSize="14" FontWeight="Bold"/>
            <PasswordBox x:Name="txtPassword" Width="280" Height="30"
                     Padding="5" FontSize="14" BorderBrush="Gray" BorderThickness="1"
                     Background="White"/>

            <Label Content="Nhập lại mật khẩu mới" FontSize="14" FontWeight="Bold"/>
            <PasswordBox x:Name="txtRePassword" Width="280" Height="30"
                     Padding="5" FontSize="14" BorderBrush="Gray" BorderThickness="1"
                     Background="White"/>

            <Label Content="Địa chỉ" FontSize="14" FontWeight="Bold"/>
            <TextBox x:Name="txtAddress" Width="280" Height="30"
                 Padding="5" FontSize="14" BorderBrush="Gray" BorderThickness="1"
                 Background="White"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                <Button Content="✔ Cập nhật" Width="120" Height="35" 
                    Foreground="White" Background="#3498DB" BorderThickness="0"
                    FontSize="14" Cursor="Hand" Click="BtnUpdate_Click"
                    Margin="5">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="✖ Hủy" Width="100" Height="35" 
                    Foreground="White" Background="#E74C3C" BorderThickness="0"
                    FontSize="14" Cursor="Hand" Click="BtnCancel_Click"
                    Margin="5">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

        </StackPanel>
    </Grid>

</Window>
