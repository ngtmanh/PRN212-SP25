<Window x:Class="Prn212.CitizenProfile"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prn212"
        mc:Ignorable="d"
        Title="CitizenProfile" Height="450" Width="800">
    <Grid Margin="20">
        <StackPanel>
            <Label Content="Full Name"/>
            <TextBox x:Name="txtFullName" Width="200"/>

            <Label Content="Email"/>
            <TextBox x:Name="txtEmail" Width="200"/>

            <Label Content="Password"/>
            <PasswordBox x:Name="txtPassword" Width="200"/>

            <Label Content="Address"/>
            <TextBox x:Name="txtAddress" Width="200"/>

            <Button Content="Cập nhật" Width="100" Height="30" Margin="10" Click="BtnUpdate_Click"/>
            <Button Content="Hủy" Width="100" Height="30" Margin="10" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
