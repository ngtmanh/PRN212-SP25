<Window x:Class="Prn212.CitizenProfile"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prn212"
        mc:Ignorable="d"
        Title="Trang chỉnh sửa thông tin cá nhân" Height="auto" Width="400">
    <Grid Margin="20">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
            <Label Content="Họ và tên" FontSize="14" FontWeight="Bold" Margin="5"/>
            <TextBox x:Name="txtFullName" Width="280" Height="30" Padding="5" BorderBrush="Gray" BorderThickness="1" IsReadOnly="True"/>

            <Label Content="Email" FontSize="14" FontWeight="Bold" Margin="5"/>
            <TextBox x:Name="txtEmail" Width="280" Height="30" Padding="5" BorderBrush="Gray" BorderThickness="1"/>

            <Label Content="Mật khẩu" FontSize="14" FontWeight="Bold" Margin="5"/>
            <PasswordBox x:Name="txtPassword" Width="280" Height="30" Padding="5" BorderBrush="Gray" BorderThickness="1"/>

            <Label Content="Địa chỉ" FontSize="14" FontWeight="Bold" Margin="5"/>
            <TextBox x:Name="txtAddress" Width="280" Height="30" Padding="5" BorderBrush="Gray" BorderThickness="1"/>

            <Button Content="Cập nhật" Width="100" Height="30" Margin="10" Click="BtnUpdate_Click"/>
            <Button Content="Hủy" Width="100" Height="30" Margin="10" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>

</Window>
