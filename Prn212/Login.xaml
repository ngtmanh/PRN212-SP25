<Window x:Class="Prn212.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prn212"
        mc:Ignorable="d"
        Title="login" Height="300" Width="400">
    <Grid Margin="0,0,0,-6">
        <Label Content="Email:" HorizontalAlignment="Left" Margin="50,50,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtEmail" HorizontalAlignment="Left" Margin="120,50,0,0" VerticalAlignment="Top" Width="200"/>

        <Label Content="Password:" HorizontalAlignment="Left" Margin="50,100,0,0" VerticalAlignment="Top"/>
        <PasswordBox x:Name="txtPassword" HorizontalAlignment="Left" Margin="120,100,0,0" VerticalAlignment="Top" Width="200"/>

        <Button Content="Login" HorizontalAlignment="Left" Margin="150,160,0,0" VerticalAlignment="Top" Width="100" Click="BtnLogin_Click"/>
        <Button Content="Register" Width="100" Height="30" Margin="10" Click="BtnRegister_Click"/>

    </Grid>
</Window>
