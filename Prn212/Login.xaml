<Window x:Class="Prn212.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập" Height="250" Width="350" WindowStartupLocation="CenterScreen">

    <Grid>
        <StackPanel Margin="20" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <Label Content="Email:" Width="80" VerticalAlignment="Center"/>
                <TextBox x:Name="txtEmail" Width="200" Height="25"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <Label Content="Mật khẩu:" Width="80" VerticalAlignment="Center"/>
                <PasswordBox x:Name="txtPassword" Width="200" Height="25"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                <Button Content="Đăng nhập" Width="100" Height="30" Margin="5" Click="BtnLogin_Click"/>
                <Button Content="Đăng kí" Width="100" Height="30" Margin="5" Click="BtnRegister_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>