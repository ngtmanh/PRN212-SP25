<Window x:Class="Prn212.ViewRegistration"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prn212"
        mc:Ignorable="d"
        Title="ViewRegistration" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="Registration Type:" />
        <ComboBox x:Name="cbStatus" Grid.Row="0" Width="200" HorizontalAlignment="Left" 
          SelectionChanged="CbStatus_SelectionChanged">
            <ComboBoxItem Content="All" />
            <ComboBoxItem Content="Pending" />
            <ComboBoxItem Content="Rejected" />
            <ComboBoxItem Content="Approved" />
        </ComboBox>


        <TextBox x:Name="txtSearch" Grid.Row="1" Width="200" Height="30" Margin="10"/>
        <TextBlock x:Name="txtCommentsPlaceholder"
                   Grid.Row="1"
               Text="Nhập số CCCD/CMND " 
               Foreground="Gray" 
               IsHitTestVisible="False" 
               VerticalAlignment="Center" 
               Margin="316,0,-311,0"
               />
        
        <Button x:Name="btnSearch" Grid.Row="1" Content="Tìm kiếm" Width="100" Margin="514,5,186,5" Click="BtnSearch_Click"/>

        <DataGrid x:Name="registrationDataGrid" Grid.Row="2" AutoGenerateColumns="False" Margin="10,10,10,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id đơn duyệt" Binding="{Binding RegistrationId}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Loại đơn" Binding="{Binding RegistrationType}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Người gửi" Binding="{Binding User.FullName}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Số CCCD/CMND" Binding="{Binding RegistrationDetail.VerifyingIdentity}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Ngày gửi" Binding="{Binding StartDate}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Duyệt bởi" Binding="{Binding ApprovedByNavigation.FullName}" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Orientation="Horizontal" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="10">
            <Button x:Name="btnAddRegistration" Content="Thêm đơn" Width="100" Margin="5" Click="BtnAddRegistration_Click"/>
            <Button x:Name="btnViewDetail" Content="Xem thông tin" Width="100" Margin="5" Click="BtnViewDetail_Click"/>
            <Button x:Name="btnBack" Content="Quay lại" Width="100" Margin="5" Click="BtnBack_Click"/>
        </StackPanel>
    </Grid>
</Window>
