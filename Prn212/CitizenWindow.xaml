<Window x:Class="Prn212.CitizenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prn212"
        mc:Ignorable="d"
        Title="Màn hình chính" Height="auto" Width="400">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Button Content="Dữ liệu cá nhân" Width="200" Height="40" Margin="10" Click="BtnProfile_Click"/>
            <Button Content="Dữ liệu nơi ở" Width="200" Height="40" Margin="10"/>
            <Button Content="Xem đơn" Width="200" Height="40" Margin="10" Click="BtnViewRegistration_Click"/>
            <Button Content="Đăng xuất" Width="200" Height="40" Margin="10" Click="BtnLogout_Click"/>
        </StackPanel>
    </Grid>
</Window>
