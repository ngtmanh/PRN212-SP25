<Window x:Class="Prn212.UpFile"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prn212"
        mc:Ignorable="d"
        Title="UpFile" Height="450" Width="800">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="Upload File" Width="150" Height="40" Click="BtnUpload_Click"/>
            <Button Content="Download File" Width="150" Height="40" Click="BtnDownload_Click" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>
