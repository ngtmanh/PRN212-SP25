<UserControl x:Class="Prn212.LeaderRigistration"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prn212"
             mc:Ignorable="d"
             Height="Auto"
             Width="Auto"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!-- Ô sort theo ngày gửi đơn -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Ngày gửi từ: " FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
            <DatePicker x:Name="StartDatePicker" Width="150" Margin="5,0" SelectedDateChanged="StartDatePicker_SelectionChanged"/>
            <TextBlock Text="Đến: " FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
            <DatePicker x:Name="EndDatePicker" Width="150" Margin="5,0" SelectedDateChanged="StartDatePicker_SelectionChanged"/>
        </StackPanel>

        <!-- Ô sort theo ngày duyệt đơn -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Ngày duyệt từ: " FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
            <DatePicker x:Name="StartDateApprovalPicker" Width="150" Margin="5,0" SelectedDateChanged="EndDatePicker_SelectionChanged"/>
            <TextBlock Text="Đến: " FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
            <DatePicker x:Name="EndDateApprovalPicker" Width="150" Margin="5,0" SelectedDateChanged="EndDatePicker_SelectionChanged"/>
        </StackPanel>

        <!-- Ô tìm kiếm -->
        <Border x:Name="borderSearch" Grid.Row="2" Padding="10" CornerRadius="8" Background="#F5F5F5" Margin="0,10,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="txtSearch" Width="300" Height="40" Padding="10" FontSize="14" Background="White" Foreground="Gray" Text="Nhập số CCCD/CMND" 
         GotFocus="txtSearch_GotFocus" LostFocus="txtSearch_LostFocus"/>
                <Button x:Name="btnSearch" Content="🔍 Tìm kiếm" Width="120" Height="40" FontSize="14" Margin="10,0,0,0" Background="#2196F3" Foreground="White" Click="BtnSearch_Click"/>
            </StackPanel>
        </Border>
        
        <DataGrid x:Name="registrationDataGrid"
                  AutoGenerateColumns="False"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  CanUserAddRows="false"
                  Margin="10" Grid.Row="3">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding RegistrationId}"
                                    Width="*" />
                <DataGridTextColumn Header="Loại đơn"
                                    Binding="{Binding RegistrationType}"
                                    Width="*" />
                <DataGridTextColumn Header="Ngày gửi"
                                    Binding="{Binding StartDate}"
                                    Width="*" />
                <DataGridTextColumn Header="Ngày duyệt"
                                    Binding="{Binding EndDate}"
                                    Width="*" />
                <DataGridTextColumn Header="Người gửi"
                                    Binding="{Binding User.FullName}"
                                    Width="*" />
                <DataGridTextColumn Header="Số CCCD/CMND"
                                    Binding="{Binding RegistrationDetail.VerifyingIdentity}"
                                    Width="*" />
                <DataGridTextColumn Header="Duyệt bởi"
                                    Binding="{Binding ApprovedByNavigation.FullName}"
                                    Width="*" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Orientation="Horizontal" Grid.Row="4" HorizontalAlignment="Center" Margin="10">
            <Button x:Name="btnViewDetail" Content="🔍 Xem thông tin" Width="140" Height="45" FontSize="14" Margin="10" Background="#2196F3" Foreground="White" Click="BtnViewDetail_Click"/>
        </StackPanel>

    </Grid>
</UserControl>
