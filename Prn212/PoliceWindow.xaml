<Window x:Class="Prn212.PoliceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prn212"
        mc:Ignorable="d"
        Title="PoliceWindow" Height="450" Width="800">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Button Content="Dữ liệu cá nhân" Width="200" Height="40" Margin="10" Click="BtnProfile_Click"/>
            <Button Content="Xem đơn duyệt" Width="200" Height="40" Margin="10"/>
            <Button Content="Đăng xuất" Width="200" Height="40" Margin="10" Click="BtnLogout_Click"/>
        </StackPanel>
    </Grid>
</Window>
